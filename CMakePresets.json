{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "bundled",
      "displayName": "Build pinned dependency sources",
      "binaryDir": "${sourceDir}/build/bundled",
      "cacheVariables": {
        "LOVE_DEPENDENCIES": "BUNDLED",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "system",
      "displayName": "Use installed dependencies",
      "binaryDir": "${sourceDir}/build/system",
      "cacheVariables": {
        "LOVE_DEPENDENCIES": "SYSTEM",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "web",
      "displayName": "WebGL 2 / WebAssembly (Emscripten 4.0.10)",
      "binaryDir": "${sourceDir}/build/web",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "LOVE_DEPENDENCIES": "BUNDLED",
        "LOVE_JIT": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "bundled",
      "configurePreset": "bundled",
      "configuration": "RelWithDebInfo",
      "targets": [
        "love"
      ],
      "jobs": 2
    },
    {
      "name": "system",
      "configurePreset": "system",
      "configuration": "RelWithDebInfo",
      "targets": [
        "love"
      ],
      "jobs": 2
    },
    {
      "name": "web",
      "configurePreset": "web",
      "targets": [
        "love"
      ],
      "jobs": 8
    }
  ]
}
