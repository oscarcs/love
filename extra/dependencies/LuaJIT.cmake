set(luajit_dir "${CMAKE_BINARY_DIR}/dependencies/luajit")
file(MAKE_DIRECTORY "${luajit_dir}")
# Lua headers must exist at configure time for consumers' dependency scanning.
foreach(header lua.h lauxlib.h lualib.h luaconf.h lua.hpp)
  configure_file("${dep}/luajit/src/${header}" "${luajit_dir}/${header}" COPYONLY)
endforeach()
if(WIN32)
  set(LOVE_LUAJIT_LIBRARY "${luajit_dir}/lua51.dll")
  set(luajit_implib "${luajit_dir}/lua51.lib")
  set(luajit_arch "${CMAKE_GENERATOR_PLATFORM}")
elseif(ANDROID)
  set(LOVE_LUAJIT_LIBRARY "${luajit_dir}/libluajit.so")
  set(luajit_arch "${ANDROID_ABI}")
elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
  set(LOVE_LUAJIT_LIBRARY "${luajit_dir}/libluajit.a")
  set(luajit_arch "${CMAKE_OSX_ARCHITECTURES}")
elseif(APPLE)
  set(LOVE_LUAJIT_LIBRARY "${luajit_dir}/libluajit-5.1.2.dylib")
  set(luajit_arch "${CMAKE_OSX_ARCHITECTURES}")
else()
  set(LOVE_LUAJIT_LIBRARY "${luajit_dir}/libluajit-5.1.so.2")
  set(luajit_arch "${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(NOT luajit_arch)
  set(luajit_arch "${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(APPLE AND luajit_arch MATCHES ";")
  message(FATAL_ERROR "Build one Apple architecture per build directory")
endif()
set(luajit_sdk "${CMAKE_OSX_SYSROOT}")
if(APPLE AND NOT IS_ABSOLUTE "${luajit_sdk}")
  if(NOT luajit_sdk)
    set(luajit_sdk macosx)
  endif()
  execute_process(COMMAND xcrun --sdk "${luajit_sdk}" --show-sdk-path OUTPUT_VARIABLE luajit_sdk OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
endif()
add_custom_command(OUTPUT "${LOVE_LUAJIT_LIBRARY}" "${luajit_dir}/luajit.h" ${luajit_implib}
  COMMAND "${Python3_EXECUTABLE}" "${recipes}/build-luajit.py" --source "${dep}/luajit"
    --directory "${luajit_dir}" --profile "${LOVE_DEPENDENCY_PROFILE}"
    --architecture "${luajit_arch}" --compiler "${CMAKE_C_COMPILER}"
    --sdk "${luajit_sdk}" --deployment-target "${CMAKE_OSX_DEPLOYMENT_TARGET}"
    --android-api "${ANDROID_PLATFORM_LEVEL}"
  DEPENDS "${recipes}/build-luajit.py" "${recipes}/sources.json" VERBATIM)
add_custom_target(love_build_luajit DEPENDS "${LOVE_LUAJIT_LIBRARY}" "${luajit_dir}/luajit.h")
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
  add_library(love_dep_luajit STATIC IMPORTED GLOBAL)
else()
  add_library(love_dep_luajit SHARED IMPORTED GLOBAL)
endif()
set_target_properties(love_dep_luajit PROPERTIES IMPORTED_LOCATION "${LOVE_LUAJIT_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${luajit_dir}")
if(WIN32)
  set_target_properties(love_dep_luajit PROPERTIES IMPORTED_IMPLIB "${luajit_implib}")
endif()
add_dependencies(love_dep_luajit love_build_luajit)
target_link_libraries(lovedep::Lua INTERFACE love_dep_luajit)
set(LOVE_EXTRA_DEPENDECIES love_build_luajit)
set(LOVE_LUAJIT_DIRECTORY "${luajit_dir}")
