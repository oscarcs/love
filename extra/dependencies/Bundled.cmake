# Dependency sources are downloaded from their original projects, verified by
# sources.json, and built with recipes owned by this fork.
find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_LIST_DIR}/sources.json" "${CMAKE_CURRENT_LIST_DIR}/fetch.py")
if(ANDROID)
  set(LOVE_DEPENDENCY_PROFILE android)
elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
  set(LOVE_DEPENDENCY_PROFILE ios)
elseif(APPLE)
  set(LOVE_DEPENDENCY_PROFILE macos)
elseif(WIN32)
  set(LOVE_DEPENDENCY_PROFILE windows)
else()
  set(LOVE_DEPENDENCY_PROFILE linux)
endif()
set(LOVE_DEPENDENCY_DIRECTORY "${love_SOURCE_DIR}/.deps/${LOVE_DEPENDENCY_PROFILE}" CACHE PATH "Downloaded dependency sources")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/fetch.py"
  --profile "${LOVE_DEPENDENCY_PROFILE}" --directory "${LOVE_DEPENDENCY_DIRECTORY}"
  RESULT_VARIABLE fetch_status)
if(NOT fetch_status EQUAL 0)
  message(FATAL_ERROR "Could not prepare pinned dependency sources")
endif()
set(dep "${LOVE_DEPENDENCY_DIRECTORY}")
set(recipes "${CMAKE_CURRENT_LIST_DIR}")
set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "Build dependency shared libraries" FORCE)
set(SKIP_INSTALL_ALL TRUE)
set(BUILD_TESTING OFF CACHE BOOL "Build dependency tests" FORCE)

# Source recipes for the small libraries without a suitable cross-platform
# upstream CMake build. These target lists derive from the original build files.
include("${recipes}/Codecs.cmake")

set(ZLIB_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
add_subdirectory("${dep}/zlib" "${CMAKE_BINARY_DIR}/dependencies/zlib" EXCLUDE_FROM_ALL)
target_link_libraries(lovedep::Zlib INTERFACE zlibstatic)
set(ZLIB_LIBRARY zlibstatic)
set(ZLIB_LIBRARIES zlibstatic)
set(ZLIB_INCLUDE_DIR "${dep}/zlib;${CMAKE_BINARY_DIR}/dependencies/zlib")
if(NOT TARGET ZLIB::ZLIB)
  add_library(ZLIB::ZLIB ALIAS zlibstatic)
endif()

add_library(love_dep_bzip2 STATIC "${dep}/bzip2/blocksort.c" "${dep}/bzip2/huffman.c"
  "${dep}/bzip2/crctable.c" "${dep}/bzip2/randtable.c" "${dep}/bzip2/compress.c"
  "${dep}/bzip2/decompress.c" "${dep}/bzip2/bzlib.c")
target_include_directories(love_dep_bzip2 PUBLIC "${dep}/bzip2")
set(BZIP2_INCLUDE_DIR "${dep}/bzip2" CACHE PATH "" FORCE)
set(BZIP2_LIBRARY_RELEASE love_dep_bzip2 CACHE STRING "" FORCE)
set(BZIP2_LIBRARY_DEBUG love_dep_bzip2 CACHE STRING "" FORCE)
set(FT_DISABLE_ZLIB ON CACHE BOOL "" FORCE)
set(FT_DISABLE_PNG ON CACHE BOOL "" FORCE)
set(FT_DISABLE_BROTLI ON CACHE BOOL "" FORCE)
set(FT_DISABLE_HARFBUZZ ON CACHE BOOL "" FORCE)
if(WIN32 OR ANDROID)
  set(FT_DISABLE_BZIP2 ON CACHE BOOL "" FORCE)
endif()
add_subdirectory("${dep}/freetype" "${CMAKE_BINARY_DIR}/dependencies/freetype" EXCLUDE_FROM_ALL)
target_link_libraries(lovedep::Freetype INTERFACE freetype)
set(HB_HAVE_FREETYPE ON CACHE BOOL "" FORCE)
set(HB_BUILD_SUBSET OFF CACHE BOOL "" FORCE)
set(HB_BUILD_UTILS OFF CACHE BOOL "" FORCE)
add_subdirectory("${dep}/harfbuzz" "${CMAKE_BINARY_DIR}/dependencies/harfbuzz" EXCLUDE_FROM_ALL)
target_link_libraries(lovedep::Harfbuzz INTERFACE harfbuzz)
if(APPLE)
  target_link_libraries(harfbuzz "-framework CoreText" "-framework CoreGraphics")
endif()

set(SDL_SHARED ON CACHE BOOL "" FORCE)
set(SDL_STATIC OFF CACHE BOOL "" FORCE)
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
  set(SDL_SHARED OFF CACHE BOOL "" FORCE)
  set(SDL_STATIC ON CACHE BOOL "" FORCE)
endif()
set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
add_subdirectory("${dep}/sdl" "${CMAKE_BINARY_DIR}/dependencies/sdl" EXCLUDE_FROM_ALL)
if(TARGET SDL3-shared)
  set(LOVE_SDL_TARGET SDL3-shared)
else()
  set(LOVE_SDL_TARGET SDL3-static)
endif()
target_link_libraries(lovedep::SDL INTERFACE ${LOVE_SDL_TARGET})

if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
  # Match the existing iOS application, which uses the SDK's OpenAL framework.
  find_library(LOVE_IOS_OPENAL OpenAL REQUIRED)
  target_link_libraries(lovedep::OpenAL INTERFACE "${LOVE_IOS_OPENAL}")
  target_compile_definitions(lovedep::OpenAL INTERFACE LOVE_APPLE_USE_FRAMEWORKS)
else()
  set(ALSOFT_UTILS OFF CACHE BOOL "" FORCE)
  set(ALSOFT_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(ALSOFT_INSTALL OFF CACHE BOOL "" FORCE)
  set(ALSOFT_INSTALL_CONFIG OFF CACHE BOOL "" FORCE)
  set(ALSOFT_INSTALL_HRTF_DATA OFF CACHE BOOL "" FORCE)
  set(ALSOFT_INSTALL_AMBDEC_PRESETS OFF CACHE BOOL "" FORCE)
  set(ALSOFT_INSTALL_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(ALSOFT_INSTALL_UTILS OFF CACHE BOOL "" FORCE)
  if(ANDROID)
    set(ALSOFT_REQUIRE_OBOE ON CACHE BOOL "" FORCE)
    set(ALSOFT_REQUIRE_OPENSL ON CACHE BOOL "" FORCE)
  endif()
  add_subdirectory("${dep}/openal" "${CMAKE_BINARY_DIR}/dependencies/openal" EXCLUDE_FROM_ALL)
  if(ANDROID)
    target_sources(OpenAL PRIVATE "${recipes}/android/opensl_latency.cpp")
  endif()
  target_link_libraries(lovedep::OpenAL INTERFACE OpenAL)
endif()

if(LOVE_JIT)
  include("${recipes}/LuaJIT.cmake")
  set(LOVE_LUA_RUNTIME "${LOVE_LUAJIT_LIBRARY}")
else()
  file(GLOB lua_sources "${dep}/lua/src/*.c")
  list(REMOVE_ITEM lua_sources "${dep}/lua/src/lua.c" "${dep}/lua/src/luac.c" "${dep}/lua/src/print.c")
  if(WIN32)
    add_library(love_dep_lua SHARED ${lua_sources})
    set_target_properties(love_dep_lua PROPERTIES OUTPUT_NAME lua51)
    target_compile_definitions(love_dep_lua PUBLIC LUA_BUILD_AS_DLL)
    set(LOVE_LUA_RUNTIME "$<TARGET_FILE:love_dep_lua>")
  else()
    add_library(love_dep_lua STATIC ${lua_sources})
  endif()
  target_include_directories(love_dep_lua PUBLIC "${dep}/lua/src")
  if(UNIX)
    target_compile_definitions(love_dep_lua PRIVATE LUA_USE_POSIX LUA_USE_DLOPEN)
    target_link_libraries(love_dep_lua PUBLIC ${CMAKE_DL_LIBS})
  endif()
  target_link_libraries(lovedep::Lua INTERFACE love_dep_lua)
endif()

if(WIN32)
  if(LOVE_JIT)
    set(lua_move_dll "${LOVE_LUAJIT_LIBRARY}")
  else()
    set(lua_move_dll love_dep_lua)
  endif()
  set(LOVE_MOVE_DLLS ${LOVE_SDL_TARGET} OpenAL ${lua_move_dll})
  set(LOVE_EXTRA_DLLS "$<TARGET_FILE:OpenAL>" ${LOVE_LUA_RUNTIME})
  set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP TRUE)
  include(InstallRequiredSystemLibraries)
  set(LOVE_MSVC_DLLS ${CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS})
endif()
